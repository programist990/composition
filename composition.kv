#:import RESOURCES resources.RESOURCES

#:set BG (0.055, 0.07, 0.09, 1)
#:set SURFACE (0.09, 0.115, 0.145, 1)
#:set SURFACE_2 (0.12, 0.15, 0.19, 1)
#:set TEXT (0.94, 0.96, 0.98, 1)
#:set MUTED (0.60, 0.66, 0.73, 1)
#:set ACCENT (0.30, 0.78, 0.74, 1)
#:set ACCENT_DARK (0.20, 0.58, 0.55, 1)
#:set DANGER (0.92, 0.34, 0.40, 1)
#:set SUCCESS (0.30, 0.78, 0.52, 1)

<DarkButton@Button>:
    background_normal: ""
    background_down: ""
    color: TEXT
    font_name: "assets/CascadiaCode.ttf"
    background_color: 0, 0, 0, 0
    canvas.before:
        Color:
            rgba: ACCENT if self.state == 'normal' else ACCENT_DARK
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]

<SoftButton@Button>:
    background_normal: ""
    background_down: ""
    color: TEXT
    font_name: "assets/CascadiaCode.ttf"
    background_color: 0, 0, 0, 0
    canvas.before:
        Color:
            rgba: SURFACE_2 if self.state == 'normal' else (0.15, 0.19, 0.24, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]

<MainLabel>:
    color: TEXT
    font_name: "assets/CascadiaCode.ttf"
    font_size: "14sp"
    valign: "middle"
    text_size: self.size
    padding_x: dp(12)
    canvas.before:
        Color:
            rgba: SURFACE
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]

<MainImage>:
    size_hint: (0.1, 0.1)
    fit_mode: 'contain'
    size_hint_x: 0.4
    pos_hint: {'center_y': 0.5}
    size_hint_y: None
    height: dp(50)

<BoxRow>:
    size_hint_x: 1
    size_hint_y: None
    height: dp(60)
    spacing: dp(8)
    padding: dp(4)
    MainLabel:
        text: root.product_name
    MainLabel:
        text: root.product_price
    MainLabel:
        text: root.product_quantity
    MainLabel:
        text: root.product_volume
    MainImage:
        source: RESOURCES[root.product_name]
    CheckBox:
        on_active: root.on_checkbox_active(self)
        active: root.cb_active
        size_hint_x: None
        width: dp(36)

<OrderRow>:
    size_hint_x: 1
    size_hint_y: None
    height: dp(60)
    spacing: dp(8)
    padding: dp(4)
    MainLabel:
        text: root.product_name
    MainLabel:
        text: root.product_price
    MainLabel:
        text: root.quantity_box
    MainImage:
        source: RESOURCES[root.product_name]

<BasketRow>:
    size_hint_x: 1
    size_hint_y: None
    height: dp(60)
    spacing: dp(8)
    padding: dp(4)
    MainLabel:
        text: root.product_name
    MainLabel:
        text: root.product_price
    MainLabel:
        text: root.quantity_box
    MainImage:
        source: RESOURCES[root.product_name]

<BasketItemScreen>:
    canvas.before:
        Color:
            rgba: BG
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: "vertical"
        padding: dp(20), dp(14)
        spacing: dp(14)

        SoftButton:
            text: "‹  Назад"
            size_hint: None, None
            size: dp(120), dp(46)
            on_press: root.goto_basket()

        Image:
            source: root.product_image
            fit_mode: "contain"
            size_hint_y: None
            height: dp(190)

        Label:
            id: text_product
            text: root.product_name
            color: TEXT
            font_name: "assets/CascadiaCode.ttf"
            font_size: "22sp"
            bold: True
            size_hint_y: None
            height: dp(44)
            text_size: self.width, None
            halign: "center"

        Widget:
            size_hint_y: 1

<MenuScreen>:
    canvas.before:
        Color:
            rgba: BG
        Rectangle:
            pos: self.pos
            size: self.size

    FloatLayout:
        padding: dp(24)

        BoxLayout:
            orientation: "vertical"
            size_hint: 0.88, 0.74
            pos_hint: {"center_x": 0.5, "center_y": 0.52}
            padding: dp(26)
            spacing: dp(18)
            canvas.before:
                Color:
                    rgba: SURFACE
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(24)]

            Label:
                text: "СКЛАД"
                font_size: "14sp"
                bold: True
                letter_spacing: 3
                color: ACCENT
                font_name: "assets/CascadiaCode.ttf"
                size_hint_y: None
                height: dp(28)

            Label:
                text: "Управляйте товарами\nбыстро и удобно"
                font_size: "28sp"
                bold: True
                color: TEXT
                font_name: "assets/CascadiaCode.ttf"
                halign: "left"
                valign: "middle"
                text_size: self.width, None
                size_hint_y: None
                height: dp(90)

            Label:
                text: "Товары, остатки и заказы — всё в одном месте."
                font_size: "15sp"
                color: MUTED
                font_name: "assets/CascadiaCode.ttf"
                halign: "left"
                valign: "top"
                text_size: self.width, None
                size_hint_y: None
                height: dp(52)

            Widget:
                size_hint_y: 1

            DarkButton:
                text: "ОТКРЫТЬ СКЛАД  →"
                font_size: "18sp"
                bold: True
                size_hint_y: None
                height: dp(60)
                on_press: root.goto_main()

            Label:
                text: "ЕЖЕДНЕВНАЯ РАБОТА  •  ПРОСТО  •  ПОНЯТНО"
                font_size: "10sp"
                color: MUTED
                font_name: "assets/CascadiaCode.ttf"
                size_hint_y: None
                height: dp(22)

<MainScreen>:
    canvas.before:
        Color:
            rgba: BG
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: dp(14), dp(12)
        spacing: dp(10)

        BoxLayout:
            size_hint_y: None
            height: dp(54)
            spacing: dp(10)

            SoftButton:
                text: "Меню"
                size_hint_x: None
                width: dp(110)
                font_size: "13sp"
                on_press: root.goto_main()

            Label:
                text: "СКЛАД"
                color: TEXT
                font_name: "assets/CascadiaCode.ttf"
                font_size: "19sp"
                bold: True
                halign: "center"
                valign: "middle"

            DarkButton:
                text: "Корзина"
                size_hint_x: None
                width: dp(120)
                font_size: "13sp"
                on_press: root.goto_basket()

        BoxLayout:
            size_hint_y: None
            height: dp(40)
            spacing: dp(6)

            Label:
                text: "ТОВАР"
                color: MUTED
                font_name: "assets/CascadiaCode.ttf"
                font_size: "11sp"
                bold: True
                halign: "left"
                valign: "middle"
            Label:
                text: "ЦЕНА"
                color: MUTED
                font_name: "assets/CascadiaCode.ttf"
                font_size: "11sp"
                bold: True
                halign: "center"
                valign: "middle"
            Label:
                text: "КОЛ."
                color: MUTED
                font_name: "assets/CascadiaCode.ttf"
                font_size: "11sp"
                bold: True
                halign: "center"
                valign: "middle"
            Label:
                text: "ОБЪЁМ"
                color: MUTED
                font_name: "assets/CascadiaCode.ttf"
                font_size: "11sp"
                bold: True
                halign: "center"
                valign: "middle"
            Widget:
                size_hint_x: 0.45

        ScrollView:
            do_scroll_x: False
            do_scroll_y: True
            bar_width: dp(4)
            scroll_type: ['bars', 'content']

            BoxLayout:
                id: main_container
                orientation: "vertical"
                size_hint_x: 1
                size_hint_y: None
                width: self.parent.width
                height: self.minimum_height
                padding: dp(2), dp(4)
                spacing: dp(8)

<ProductScreen>:
    canvas.before:
        Color:
            rgba: BG
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: "vertical"
        padding: dp(20), dp(14)
        spacing: dp(12)

        SoftButton:
            text: "‹  Назад"
            size_hint: None, None
            size: dp(120), dp(46)
            on_press: root.goto_main()

        Image:
            source: root.product_image
            fit_mode: "contain"
            size_hint_y: None
            height: dp(190)

        Label:
            id: text_product
            text: root.product_name
            color: TEXT
            font_name: "assets/CascadiaCode.ttf"
            font_size: "22sp"
            bold: True
            size_hint_y: None
            height: dp(44)
            halign: "center"
            text_size: self.width, None

        Label:
            text: "Количество"
            color: MUTED
            font_name: "assets/CascadiaCode.ttf"
            font_size: "13sp"
            size_hint_y: None
            height: dp(24)
            halign: "center"

        Label:
            id: text_quantity
            text: root.product_quantity
            color: TEXT
            font_name: "assets/CascadiaCode.ttf"
            font_size: "30sp"
            bold: True
            size_hint_y: None
            height: dp(52)
            halign: "center"

        BoxLayout:
            size_hint_y: None
            height: dp(58)
            spacing: dp(14)
            padding: dp(24), 0

            Button:
                text: "−"
                font_size: "28sp"
                bold: True
                background_normal: ""
                background_color: 0, 0, 0, 0
                color: TEXT
                canvas.before:
                    Color:
                        rgba: DANGER
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(16)]
                on_press: root.delete_quantity()

            Widget:
                size_hint_x: 1

            Button:
                text: "+"
                font_size: "28sp"
                bold: True
                background_normal: ""
                background_color: 0, 0, 0, 0
                color: TEXT
                canvas.before:
                    Color:
                        rgba: ACCENT
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(16)]
                on_press: root.add_quantity()

        Widget:
            size_hint_y: 1

<BasketScreen>:
    canvas.before:
        Color:
            rgba: BG
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: "vertical"
        padding: dp(16), dp(14)
        spacing: dp(10)

        SoftButton:
            text: "‹  Назад"
            size_hint: None, None
            size: dp(120), dp(46)
            on_press: root.goto_main()

        Label:
            text: "Корзина"
            color: TEXT
            font_name: "assets/CascadiaCode.ttf"
            font_size: "24sp"
            bold: True
            size_hint_y: None
            height: dp(42)

        BoxLayout:
            size_hint_y: None
            height: dp(34)
            spacing: dp(8)
            Label:
                text: "ТОВАР"
                color: MUTED
                font_size: "11sp"
                bold: True
            Label:
                text: "ЦЕНА"
                color: MUTED
                font_size: "11sp"
                bold: True
            Label:
                text: "КОЛ."
                color: MUTED
                font_size: "11sp"
                bold: True
            Widget:
                size_hint_x: 0.4

        ScrollView:
            do_scroll_x: False
            do_scroll_y: True
            BoxLayout:
                id: basket_container
                orientation: "vertical"
                size_hint_x: 1
                size_hint_y: None
                width: self.parent.width
                height: self.minimum_height
                spacing: dp(8)

        DarkButton:
            text: "ОФОРМИТЬ ЗАКАЗ"
            size_hint: None, None
            pos_hint: {"center_x": 0.5}
            size: dp(220), dp(56)
            font_size: "16sp"
            bold: True
            on_press: root.goto_order()

<Order>:
    canvas.before:
        Color:
            rgba: BG
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(12)

        BoxLayout:
            size_hint_y: None
            height: dp(54)
            spacing: dp(10)

            SoftButton:
                text: "‹  Назад"
                size_hint_x: None
                width: dp(120)
                on_press: root.goto_basket()

            Label:
                text: "Заказ"
                font_size: "23sp"
                bold: True
                color: TEXT
                font_name: "assets/CascadiaCode.ttf"
                halign: "center"
                valign: "middle"

            Widget:
                size_hint_x: None
                width: dp(120)

        Label:
            text: "Номер заказа: " + str(root.number_order())
            font_size: "13sp"
            color: MUTED
            size_hint_y: None
            height: dp(24)
            halign: "left"

        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: dp(52)
            spacing: dp(10)

            TextInput:
                hint_text: "Имя"
                multiline: False
                font_size: "16sp"
                background_normal: ""
                background_color: SURFACE
                foreground_color: TEXT
                hint_text_color: MUTED
                cursor_color: ACCENT
                padding: dp(14), dp(12)
                on_text: root.buyer_details("name", self.text)

            TextInput:
                hint_text: "Фамилия"
                multiline: False
                font_size: "16sp"
                background_normal: ""
                background_color: SURFACE
                foreground_color: TEXT
                hint_text_color: MUTED
                cursor_color: ACCENT
                padding: dp(14), dp(12)
                on_text: root.buyer_details("Фамилия", self.text)

        BoxLayout:
            size_hint_y: None
            height: dp(34)
            spacing: dp(8)
            Label:
                text: "ТОВАР"
                bold: True
                color: MUTED
            Label:
                text: "ЦЕНА"
                bold: True
                color: MUTED
            Label:
                text: "КОЛИЧЕСТВО"
                bold: True
                color: MUTED
            Widget:
                size_hint_x: 0.4

        ScrollView:
            do_scroll_x: False
            do_scroll_y: True
            BoxLayout:
                id: order_products
                orientation: "vertical"
                size_hint_x: 1
                size_hint_y: None
                width: self.parent.width
                height: self.minimum_height
                spacing: dp(8)

        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: dp(42)
            spacing: dp(10)
            CheckBox:
                size_hint_x: None
                width: dp(40)
                active: root.pack_order
                on_active: root.toggle_packing(self.active)
            Label:
                text: "Упаковать в коробку (10 л)"
                font_size: "14sp"
                color: TEXT
                halign: "left"
                valign: "middle"
                text_size: self.size

        Label:
            text: root.volume_status
            font_size: "12sp"
            color: DANGER
            size_hint_y: None
            height: dp(22)
            halign: "left"

        Label:
            text: root.box_count_status
            font_size: "12sp"
            color: SUCCESS
            size_hint_y: None
            height: dp(22)
            halign: "left"

        Widget:
            size_hint_y: 0.2

        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: dp(56)
            spacing: dp(12)

            Label:
                text: root.total_price
                font_size: "22sp"
                bold: True
                color: TEXT
                halign: "left"
                valign: "middle"

            DarkButton:
                text: "Подтвердить"
                size_hint_x: None
                width: dp(190)
                font_size: "16sp"
                bold: True
                on_press: root.confirm_order()

<OrderConfirmedScreen>:
    canvas.before:
        Color:
            rgba: BG
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: dp(28), dp(30)
        spacing: dp(18)

        Widget:
            size_hint_y: 1

        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: dp(140)
            Widget:
                size_hint_x: 1
            Widget:
                id: circle_bg
                size_hint: None, None
                size: dp(140), dp(140)
                canvas.before:
                    Color:
                        rgba: SUCCESS
                    Ellipse:
                        pos: self.pos
                        size: self.size
                    Color:
                        rgba: BG
                    Ellipse:
                        pos: self.x + dp(8), self.y + dp(8)
                        size: self.width - dp(16), self.height - dp(16)
                    Color:
                        rgba: SUCCESS
                    Line:
                        points: [self.x + self.width * 0.28, self.y + self.height * 0.52, self.x + self.width * 0.45, self.y + self.height * 0.30, self.x + self.width * 0.76, self.y + self.height * 0.66]
                        width: dp(8)
                        cap: "round"
                        joint: "round"
            Widget:
                size_hint_x: 1

        Label:
            text: "Спасибо, " + root.buyer_full_name + "!"
            font_size: "24sp"
            bold: True
            color: TEXT
            font_name: "assets/CascadiaCode.ttf"
            size_hint_y: None
            height: dp(38)

        Label:
            text: "Ваш заказ успешно оформлен.\nНомер заказа #" + root.order_number + "."
            font_size: "15sp"
            color: MUTED
            font_name: "assets/CascadiaCode.ttf"
            size_hint_y: None
            height: dp(60)
            text_size: self.width, None
            halign: "center"

        Widget:
            size_hint_y: 1

        DarkButton:
            text: "ВЕРНУТЬСЯ В СКЛАД"
            size_hint_y: None
            height: dp(54)
            font_size: "15sp"
            bold: True
            on_press: root.goto_main()
