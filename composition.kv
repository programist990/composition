#:import RESOURCES resources.RESOURCES

<MenuButton@Button>
    font_size: "40dp"
    font_name: "assets/CascadiaCode.ttf"


<MainLabel>:
    color: "black"
    font_name: "assets/CascadiaCode.ttf"
    canvas.before:
        Color:
            rgba:(0.6, 0.7, 0.85, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10)]


<MainImage>:
    size_hint: (0.1, 0.1)
    fit_mode: 'contain'
    size_hint_x: 0.4
    pos_hint: {'center_y': 0.5}
    size_hint_y: None
    height: dp(50)


<BoxRow>:
    size_hint_y: None
    height: dp(50)
    spacing: dp(10)
    MainLabel:
        text: root.product_name
    MainLabel:
        text: root.product_price
    MainLabel:
        text: root.product_quantity
    MainLabel:
        text: root.product_volume
    MainImage:
        source: RESOURCES[root.product_name]
    CheckBox:
        on_active: root.on_checkbox_active(self)
        active: root.cb_active

<OrderRow>:
    size_hint_y: None
    height: dp(50)
    spacing: dp(10)
    MainLabel:
        text: root.product_name
    MainLabel:
        text: root.product_price
    MainLabel:
        text: root.quantity_box
    # MainLabel:
    #     text: root.box_count
    MainImage:
        source: RESOURCES[root.product_name]    
<BasketRow>:
    size_hint_y: None
    height: dp(50)
    spacing: dp(10)
    MainLabel:
        text: root.product_name
    MainLabel:
        text: root.product_price
    MainLabel:
        text: root.quantity_box
    # MainLabel:
    #     text: root.box_count
    MainImage:
        source: RESOURCES[root.product_name]


<BasketItemScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: "20dp", "10dp"
        spacing: "8dp"

        Button:
            text: "< Назад"
            size_hint: None, None
            size: "120dp", "50dp"
            background_normal: ""
            background_color: 0.3, 0.3, 0.3, 1
            on_press: root.goto_basket()

        Image:
            source: root.product_image
            fit_mode: "contain"
            size_hint_y: None
            height: "160dp"

        MainLabel:
            id: text_product
            text: root.product_name
            size_hint: (None, None)
            size: (dp(180), dp(45))
            pos_hint: {"center_x": 0.5}



        Widget:
            size_hint_y: 1



<MenuScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: 80
        Label:
            text: "Склад"
            font_size: "40sp"
            color: (0.15, 0.15, 0.15, 1)
            font_name: "assets/CascadiaCode.ttf"
            canvas.before:
                Color:
                    rgba: (0.85, 0.87, 0.90, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(10)]
        Image:
            source: 'assets/images/logo.png'
            fit_mode: 'cover'
        MenuButton:
            text: "Открыть"
            on_press: root.goto_main()

            background_normal: ""
            background_down: ""
            background_color: 0, 0, 0, 0
            canvas.before:
                Color:
                    rgba: (0.11, 0.31, 0.85, 1) if self.state == 'normal' else (0.15, 0.39, 0.92, 1)

                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(10)]


<MainScreen>:
    BoxLayout:
        orientation: "vertical"
        BoxLayout:
            size_hint_y: None
            height: "56dp"
            padding: "10dp", "8dp"
            spacing: "10dp"

            Button:
                text: "Меню"
                size_hint: None, None
                size: "100dp", "40dp"
                background_normal: ""
                background_color: 0.3, 0.3, 0.3, 1
                on_press: root.goto_main()

            Widget:
                size_hint_y: 0.5


            Button:
                text: "Корзина"
                size_hint: None, None
                size: "120dp", "40dp"
                background_normal: ""
                background_color: 0.11, 0.31, 0.85, 1
                on_press: root.goto_basket()

        BoxLayout:
            size_hint_y: None
            height: "56dp"
            padding: "10dp", "8dp"
            spacing: "10dp"
            Widget:
                size_hint_x: 0.1
            Label:
                text: "Название:"
            Widget:
                size_hint_x: 0.1
            Label:
                text: "Цена:"
            # Widget:
            #     size_hint_x: 0.1
            Label:
                text: " Кол.:"
            Label:
                text: "Объём:"
            Widget:
                size_hint_x: 1
            Widget:
                size_hint_x: 1
                
        ScrollView:
            do_scroll_x: False
            do_scroll_y: True

            BoxLayout:
                id: main_container
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: '20dp'
                spacing: '6dp'


<ProductScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: "20dp", "10dp"
        spacing: "8dp"

        Button:
            text: "< Назад"
            size_hint: None, None
            size: "120dp", "50dp"
            background_normal: ""
            background_color: 0.3, 0.3, 0.3, 1
            on_press: root.goto_main()

        Image:
            source: root.product_image
            fit_mode: "contain"
            size_hint_y: None
            height: "160dp"

        MainLabel:
            id: text_product
            text: root.product_name
            size_hint: (None, None)
            size: (dp(180), dp(45))
            pos_hint: {"center_x": 0.5}

        MainLabel:
            id: text_quantity
            text: root.product_quantity
            size_hint: (None, None)
            size: (dp(100), dp(45))
            pos_hint: {"center_x": 0.5}

        BoxLayout:
            size_hint_y: None
            height: "70dp"
            spacing: "15dp"
            padding: "60dp", 0

            Button:
                text: "+"
                size_hint: None, None
                size: "65dp", "65dp"
                background_normal: ""
                background_color: 0.2, 0.7, 0.2, 1
                radius: [32]
                on_press: root.add_quantity()

            Widget:
                size_hint_x: 1

            Button:
                text: "-"
                size_hint: None, None
                size: "65dp", "65dp"
                background_normal: ""
                background_color: 0.8, 0.2, 0.2, 1
                radius: [32]
                on_press: root.delete_quantity()

        Widget:
            size_hint_y: 1


<BasketScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: "20dp", "10dp"
        spacing: "8dp"

        Button:
            text: "< Назад"
            size_hint: None, None
            size: "120dp", "50dp"
            background_normal: ""
            background_color: 0.3, 0.3, 0.3, 1
            on_press: root.goto_main()

        BoxLayout:
            size_hint_y: None
            height: "36dp"
            spacing: "10dp"
            padding: "20dp", 0

            Label:
                text: "Товар"
            Label:
                text: "Цена"
            Label:
                text: "Кол.:"

            Widget:
                size_hint_x: 0.4

        ScrollView:
            do_scroll_x: False
            do_scroll_y: True

            BoxLayout:
                id: basket_container
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: '20dp'
                spacing: '6dp'
        
        Button:
            text: "Заказать"
            size_hint: None, None
            pos_hint: {"center_x": 0.5}
            size: "160dp", "56dp"
            font_size: "18sp"
            bold: True
            background_normal: ""
            background_color: (0.18, 0.75, 0.38, 1) if self.state == 'normal' else (0.22, 0.82, 0.44, 1)
            color: 1, 1, 1, 1
            on_press: root.goto_order()




<Order>:
    canvas.before:
        Color:
            rgba: 0, 0, 0, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: "20dp"
        spacing: "16dp"

        BoxLayout:
            size_hint_y: None
            height: "60dp"

            Button:
                text: "< Назад"
                size_hint_x: None
                width: "90dp"
                font_size: "15sp"
                background_normal: ""
                background_down: ""
                background_color: 0, 0, 0, 0
                color: 0.7, 0.75, 0.85, 1
                on_press: root.goto_basket()

            Label:
                text: "Заказ"
                font_size: "28sp"
                bold: True
                color: 1, 1, 1, 1

            Widget:
                size_hint_x: None
                width: "90dp"

        BoxLayout:
            size_hint_y: None
            height: "30dp"
            Label:
                text: "Номер заказа: " + str(root.number_order())
                font_size: "16sp"
                color: 0.7, 0.75, 0.85, 1

        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: "50dp"
            spacing: "12dp"

            TextInput:
                hint_text: "Имя"
                multiline: False
                font_size: "18sp"
                background_color: 0.15, 0.17, 0.23, 1
                foreground_color: 1, 1, 1, 1
                hint_text_color: 0.55, 0.6, 0.7, 1
                cursor_color: 1, 1, 1, 1
                padding: "14dp"
                on_text: root.buyer_details("name", self.text)

            TextInput:
                hint_text: "Фамилия"
                multiline: False
                font_size: "18sp"
                background_color: 0.15, 0.17, 0.23, 1
                foreground_color: 1, 1, 1, 1
                hint_text_color: 0.55, 0.6, 0.7, 1
                cursor_color: 1, 1, 1, 1
                padding: "14dp"
                on_text: root.buyer_details("Фамилия", self.text)

        ScrollView:
            do_scroll_x: False
            do_scroll_y: True
            BoxLayout:
                id: order_products
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: "8dp"

        BoxLayout:
            size_hint_y: None
            height: "36dp"
            spacing: "10dp"
            padding: "10dp", 0

            Label:
                text: "Товар"
                bold: True
                color: 0.7, 0.75, 0.85, 1
            Label:
                text: "Цена"
                bold: True
                color: 0.7, 0.75, 0.85, 1
            Label:
                text: "Количество"
                bold: True
                color: 0.7, 0.75, 0.85, 1

            Widget:
                size_hint_x: 0.4

        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: "40dp"
            spacing: "10dp"

            CheckBox:
                size_hint_x: None
                width: "40dp"
                active: root.pack_order
                on_active: root.toggle_packing(self.active)

            Label:
                text: "Упаковать в коробку (10 л)"
                font_size: "15sp"
                color: 1, 1, 1, 1
                text_size: self.size

        BoxLayout:
            size_hint_y: None
            height: "26dp"
            opacity: 1 

            Label:
                text: root.volume_status
                font_size: "13sp"
                color: 0.95, 0.3, 0.3, 1
                halign: "left"
                valign: "middle"
                text_size: self.size

        BoxLayout:
            size_hint_y: None
            height: "26dp"
            opacity: 1

            Label:
                text: root.box_count_status
                font_size: "13sp"
                color: 0.6, 0.85, 0.6, 1
                halign: "left"
                valign: "middle"
                text_size: self.size
            
        Widget:
            size_hint_y: 0.3

        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: "56dp"
            spacing: "12dp"

            Label:
                text: root.total_price
                font_size: "22sp"
                bold: True
                color: 1, 1, 1, 1

            Button:
                text: "Подтвердить"
                size_hint: None, None
                size: "200dp", "56dp"
                font_size: "20sp"
                bold: True
                background_normal: ""
                background_color: (0.18, 0.75, 0.38, 1) if self.state == 'normal' else (0.22, 0.82, 0.44, 1)
                color: 1, 1, 1, 1
                on_press: root.confirm_order()


<OrderConfirmedScreen>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: "32dp", "40dp"
        spacing: "22dp"

        Widget:
            size_hint_y: 1

        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: "160dp"

            Widget:
                size_hint_x: 1
            Widget:
                id: circle_bg
                size_hint: None, None
                size: "160dp", "160dp"
                canvas.before:
                    Color:
                        rgba: 0.20, 0.68, 0.32, 1
                    Ellipse:
                        pos: self.pos
                        size: self.size
                    Color:
                        rgba: 1, 1, 1, 1
                    Line:
                        points: [self.x + self.width * 0.28, self.y + self.height * 0.52, self.x + self.width * 0.45, self.y + self.height * 0.30, self.x + self.width * 0.76, self.y + self.height * 0.66]
                        width: dp(8)
                        cap: "round"
                        joint: "round"
            Widget:
                size_hint_x: 1

        Label:
            text: "Спасибо, " + root.buyer_full_name + "!"
            font_size: "24sp"
            bold: True
            color: 0.1, 0.1, 0.1, 1
            size_hint_y: None
            height: "34dp"

        Label:
            text: "Ваш заказ успешно оформлен. Мы свяжемся с вами в ближайшее время.\nНомер вашего заказа #" + root.order_number + "."
            font_size: "15sp"
            color: 0.4, 0.4, 0.4, 1
            size_hint_y: None
            height: "60dp"
            text_size: self.width, None

        Widget:
            size_hint_y: 1

        Button:
            text: "ВЕРНУТЬСЯ В МАГАЗИН"
            height: "52dp"
            font_size: "16sp"
            bold: True
            background_color: 0.86, 0.14, 0.28, 1
            color: 1, 1, 1, 1
            on_press: root.goto_main()
